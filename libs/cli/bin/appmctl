}

_files_update() {
  local app="${APP:-}"
  local name=""
  local metadata=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --name) require_value "$1" "$2"; name="$2"; shift 2 ;;
      --name=*) name=${1#*=}; shift ;;
      --metadata) require_value "$1" "$2"; metadata="$2"; shift 2 ;;
      --metadata=*) metadata=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl files update [--app APP] --name NAME --metadata JSON\n'
        return 0
        ;;
      *) die "unknown files update option: $1" ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$name" ] || die "--name is required"
  validate_file_name "$name"
  [ -n "$metadata" ] || die "--metadata is required"

  local path="apps/$APP/files/$(url_encode_segment "$name")"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: PATCH\n'
    printf 'url: %s\n' "$url"
    printf 'metadata: %s\n' "$metadata"
    return 0
  fi

  require_jq
  ensure_tmpdir
  local body_file
  body_file=$(new_temp_file files-update) || return 1
  printf '%s' "$metadata" | "$JQ_BIN" '{metadata: .}' >"$body_file" \
    || die "--metadata must be valid JSON"

  api_patch "$path" "$body_file" || return 1
  local fmt='{"type":"resource","fields":{"name":"name","mime_type":"mime_type","size":"size","created_at":"created_at"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_files_delete() {
  local app="${APP:-}"
  local name=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --name) require_value "$1" "$2"; name="$2"; shift 2 ;;
      --name=*) name=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl files delete [--app APP] --name NAME\n'
        return 0
        ;;
      -*) die "unknown files delete option: $1" ;;
      *)
        [ -z "$name" ] || die "unexpected argument: $1"
        name="$1"
        shift
        ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$name" ] || die "--name is required"
  validate_file_name "$name"

  local path="apps/$APP/files/$(url_encode_segment "$name")"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: DELETE\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_delete "$path" || return 1
  printf 'File %s deleted\n' "$name"
}


# "assets" subcommands: list, show, download, upload, delete.
#
# Assets are app icon and splash screen images. Each app has at most one icon
# and one splash screen. Uploading replaces the existing asset.

assets_usage() {
  cat <<'EOF'
Usage:
  appmctl [global options] assets <action> [options]

Actions:
  list                List available asset download URLs
  show                Preview an asset (inline)
  download            Download an asset or a named variant
  upload              Upload or replace an icon or splash screen
  delete              Delete an asset

Options:
  --app APP           App slug (default: APP_MANAGER_APP)
  --type TYPE         Asset type: icon or splashscreen (required for show, download, upload, delete)
  --file FILE         File to upload (upload)
  --variant VARIANT   Variant name (download; default "original")

Run "appmctl assets <action> --help" for action-specific help.
EOF
}

validate_asset_type() {
  local value="$1"
  case "$value" in
    icon|splashscreen) ;;
    *) die "--type must be \"icon\" or \"splashscreen\"" ;;
  esac
}

command_assets() {
  local action="${1:-}"
  shift 2>/dev/null || true

  case "$action" in
    list) _assets_list "$@" ;;
    show) _assets_show "$@" ;;
    download) _assets_download "$@" ;;
    upload) _assets_upload "$@" ;;
    delete) _assets_delete "$@" ;;
    -h|--help|"") assets_usage; [ -z "$action" ] && return 1; return 0 ;;
    *) die "unknown assets action: $action (use list, show, download, upload, delete)" ;;
  esac
}

_assets_list() {
  local app="${APP:-}"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl assets list [--app APP]\n'
        return 0
        ;;
      *) die "unknown assets list option: $1" ;;
    esac
  done

  APP="$app"
  require_app

  local path="apps/$APP/assets"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_get "$path" || return 1

  if [ "$PRETTY_JSON" -eq 1 ]; then
    emit_response
    return
  fi

  _assets_print_url_map "$LAST_RESPONSE_FILE"
}

# This endpoint answers with an object keyed by "<asset>.<variant>", not the array
# of records the table formatter expects, so it gets its own printer.
_assets_print_url_map() {
  local json_file="$1"
  local key
  local value
  local width=5
  local dashes

  require_jq

  while IFS= read -r key; do
    [ "${#key}" -gt "$width" ] && width=${#key}
  done < <("$JQ_BIN" -r '.data // {} | keys_unsorted[]' "$json_file")

  if [ "$width" -eq 5 ] && [ "$("$JQ_BIN" -r '.data // {} | length' "$json_file")" = "0" ]; then
    printf '(no assets)\n'
    return 0
  fi

  dashes=$(printf '%*s' "$width" '' | tr ' ' '-')
  printf "%-${width}s  %s\n" 'asset' 'url'
  printf '%s  %s\n' "$dashes" '---'

  while IFS=$'\t' read -r key value; do
    printf "%-${width}s  %s\n" "$key" "$value"
  done < <("$JQ_BIN" -r '.data // {} | to_entries[] | "\(.key)\t\(.value)"' "$json_file")
}

_assets_show() {
  local app="${APP:-}"
  local type=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --type) require_value "$1" "$2"; type="$2"; shift 2 ;;
      --type=*) type=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl assets show [--app APP] --type icon|splashscreen [-o FILE]\n'
        return 0
        ;;
      *) die "unknown assets show option: $1" ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$type" ] || die "--type is required"
  validate_asset_type "$type"

  local path="apps/$APP/assets/$type"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  check_output_destination
  api_get "$path" || return 1
  emit_response
}

_assets_download() {
  local app="${APP:-}"
  local type=""
  local variant="original"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --type) require_value "$1" "$2"; type="$2"; shift 2 ;;
      --type=*) type=${1#*=}; shift ;;
      --variant) require_value "$1" "$2"; variant="$2"; shift 2 ;;
      --variant=*) variant=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl assets download [--app APP] --type icon|splashscreen [--variant VARIANT] [-o FILE]\n'
        printf '\nVariants:\n  original  Original file (default)\n  ios-icon-40  android-icon-mdpi  ... (see "appmctl assets list")\n'
        return 0
        ;;
      *) die "unknown assets download option: $1" ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$type" ] || die "--type is required"
  validate_asset_type "$type"
  [ -n "$variant" ] || die "--variant must not be empty"

  local path="apps/$APP/assets/$type/files/$variant"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  check_output_destination
  api_get "$path" || return 1
  emit_response
}

_assets_upload() {
  local app="${APP:-}"
  local type=""
  local file_path=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --type) require_value "$1" "$2"; type="$2"; shift 2 ;;
      --type=*) type=${1#*=}; shift ;;
      --file) require_value "$1" "$2"; file_path="$2"; shift 2 ;;
      --file=*) file_path=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl assets upload [--app APP] --type icon|splashscreen --file FILE\n'
        return 0
        ;;
      *) die "unknown assets upload option: $1" ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$type" ] || die "--type is required"
  validate_asset_type "$type"
  [ -n "$file_path" ] || die "--file is required"
  [ -f "$file_path" ] || die "file does not exist: $file_path"

  local path="apps/$APP/assets/$type"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: POST\n'
    printf 'url: %s\n' "$url"
    printf 'file: %s\n' "$file_path"
    return 0
  fi

  require_curl
  require_jq
  ensure_tmpdir
  local url
  url=$(build_url "$path") || return 1

  reset_request
  REQUEST_BODY_KIND="multipart"
  REQUEST_FILES+=("file=$file_path")

  perform_request POST "$url" || return 1
  local fmt='{"type":"resource","fields":{"slug":"slug","name":"name","created_at":"created_at"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_assets_delete() {
  local app="${APP:-}"
  local type=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --type) require_value "$1" "$2"; type="$2"; shift 2 ;;
      --type=*) type=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl assets delete [--app APP] --type icon|splashscreen\n'
        return 0
        ;;
      *) die "unknown assets delete option: $1" ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$type" ] || die "--type is required"
  validate_asset_type "$type"

  local path="apps/$APP/assets/$type"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: DELETE\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_delete "$path" || return 1
  printf 'Asset %s deleted\n' "$type"
}


# "identifiers" subcommands: list, show, create, update, delete.
#
# App identifiers are the per-platform bundle IDs, package names, and web domains
# an app ships under. Uniqueness, the Android-only version_code rule, and the web
# domain format are enforced by the API, not here, so the CLI cannot drift from it.

identifiers_usage() {
  cat <<'EOF'
Usage:
  appmctl [global options] identifiers <action> [options]

Actions:
  list                List identifiers for an app
  show                Show a single identifier
  create              Add an identifier
  update              Update an identifier
  delete              Remove an identifier

Options:
  --app APP           App slug (default: APP_MANAGER_APP)
  --platform PLATFORM ios, android, or web (required for create)
  --identifier ID     Bundle ID, package name, or domain (required for create)
  --name NAME         Display name
  --version VERSION   Marketing version
  --version-code N    Android version code (android only)
  --per-page N        Page size for list

Run "appmctl identifiers <action> --help" for action-specific help.
EOF
}

validate_platform() {
  case "$1" in
    ios|android|web) ;;
    *) die "--platform must be \"ios\", \"android\", or \"web\"" ;;
  esac
}

command_identifiers() {
  local action="${1:-}"
  shift 2>/dev/null || true

  case "$action" in
    list) _identifiers_list "$@" ;;
    show) _identifiers_show "$@" ;;
    create) _identifiers_create "$@" ;;
    update) _identifiers_update "$@" ;;
    delete) _identifiers_delete "$@" ;;
    -h|--help|"") identifiers_usage; [ -z "$action" ] && return 1; return 0 ;;
    *) die "unknown identifiers action: $action (use list, show, create, update, delete)" ;;
  esac
}

_identifiers_list() {
  local app="${APP:-}"
  local per_page=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --per-page) require_value "$1" "$2"; per_page="$2"; shift 2 ;;
      --per-page=*) per_page=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl identifiers list [--app APP] [--per-page N]\n'
        return 0
        ;;
      *) die "unknown identifiers list option: $1" ;;
    esac
  done

  APP="$app"
  require_app

  local path="apps/$APP/identifiers"
  if [ -n "$per_page" ]; then
    case "$per_page" in
      ''|*[!0-9]*) die "--per-page must be a positive integer" ;;
    esac
    path="$path?per_page=$per_page"
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_get "$path" || return 1
  local fmt='{"type":"table","fields":["id","platform","identifier","name","version"],"headers":["id","platform","identifier","name","version"]}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_identifiers_show() {
  local app="${APP:-}"
  local identifier_id=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl identifiers show [--app APP] <identifier-id>\n'
        return 0
        ;;
      -*) die "unknown identifiers show option: $1" ;;
      *)
        [ -z "$identifier_id" ] || die "unexpected argument: $1"
        identifier_id="$1"
        shift
        ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$identifier_id" ] || die "identifier ID is required"

  local path="apps/$APP/identifiers/$identifier_id"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_get "$path" || return 1
  emit_formatted_response "$LAST_RESPONSE_FILE" "$(_identifiers_resource_format)"
}

_identifiers_create() {
  local app="${APP:-}"
  local platform=""
  local identifier=""
  local name=""
  local version=""
  local version_code=""
  local body_file

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --platform) require_value "$1" "$2"; platform="$2"; shift 2 ;;
      --platform=*) platform=${1#*=}; shift ;;
      --identifier) require_value "$1" "$2"; identifier="$2"; shift 2 ;;
      --identifier=*) identifier=${1#*=}; shift ;;
      --name) require_value "$1" "$2"; name="$2"; shift 2 ;;
      --name=*) name=${1#*=}; shift ;;
      --version) require_value "$1" "$2"; version="$2"; shift 2 ;;
      --version=*) version=${1#*=}; shift ;;
      --version-code) require_value "$1" "$2"; version_code="$2"; shift 2 ;;
      --version-code=*) version_code=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl identifiers create [--app APP] --platform ios|android|web --identifier ID [--name NAME] [--version VERSION] [--version-code N]\n'
        return 0
        ;;
      *) die "unknown identifiers create option: $1" ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$platform" ] || die "--platform is required"
  validate_platform "$platform"
  [ -n "$identifier" ] || die "--identifier is required"
  _identifiers_validate_version_code "$version_code"

  require_jq
  ensure_tmpdir
  body_file=$(new_temp_file identifiers-create) || return 1
  _identifiers_build_body "$body_file" "$platform" "$identifier" "$name" "$version" "$version_code"

  local path="apps/$APP/identifiers"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: POST\n'
    printf 'url: %s\n' "$url"
    printf 'body: %s\n' "$(cat "$body_file")"
    return 0
  fi

  api_post "$path" "$body_file" || return 1
  emit_formatted_response "$LAST_RESPONSE_FILE" "$(_identifiers_resource_format)"
}

_identifiers_update() {
  local app="${APP:-}"
  local identifier_id=""
  local platform=""
  local identifier=""
  local name=""
  local version=""
  local version_code=""
  local has_fields=0
  local body_file

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --platform) require_value "$1" "$2"; platform="$2"; has_fields=1; shift 2 ;;
      --platform=*) platform=${1#*=}; has_fields=1; shift ;;
      --identifier) require_value "$1" "$2"; identifier="$2"; has_fields=1; shift 2 ;;
      --identifier=*) identifier=${1#*=}; has_fields=1; shift ;;
      --name) require_value "$1" "$2"; name="$2"; has_fields=1; shift 2 ;;
      --name=*) name=${1#*=}; has_fields=1; shift ;;
      --version) require_value "$1" "$2"; version="$2"; has_fields=1; shift 2 ;;
      --version=*) version=${1#*=}; has_fields=1; shift ;;
      --version-code) require_value "$1" "$2"; version_code="$2"; has_fields=1; shift 2 ;;
      --version-code=*) version_code=${1#*=}; has_fields=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl identifiers update [--app APP] <identifier-id> [--platform PLATFORM] [--identifier ID] [--name NAME] [--version VERSION] [--version-code N]\n'
        return 0
        ;;
      -*) die "unknown identifiers update option: $1" ;;
      *)
        [ -z "$identifier_id" ] || die "unexpected argument: $1"
        identifier_id="$1"
        shift
        ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$identifier_id" ] || die "identifier ID is required"
  [ "$has_fields" -eq 1 ] || die "at least one field to update is required"
  [ -z "$platform" ] || validate_platform "$platform"
  _identifiers_validate_version_code "$version_code"

  require_jq
  ensure_tmpdir
  body_file=$(new_temp_file identifiers-update) || return 1
  _identifiers_build_body "$body_file" "$platform" "$identifier" "$name" "$version" "$version_code"

  local path="apps/$APP/identifiers/$identifier_id"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: PATCH\n'
    printf 'url: %s\n' "$url"
    printf 'body: %s\n' "$(cat "$body_file")"
    return 0
  fi

  api_patch "$path" "$body_file" || return 1
  emit_formatted_response "$LAST_RESPONSE_FILE" "$(_identifiers_resource_format)"
}

_identifiers_delete() {
  local app="${APP:-}"
  local identifier_id=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl identifiers delete [--app APP] <identifier-id>\n'
        return 0
        ;;
      -*) die "unknown identifiers delete option: $1" ;;
      *)
        [ -z "$identifier_id" ] || die "unexpected argument: $1"
        identifier_id="$1"
        shift
        ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$identifier_id" ] || die "identifier ID is required"

  local path="apps/$APP/identifiers/$identifier_id"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: DELETE\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_delete "$path" || return 1
  printf 'Identifier %s deleted\n' "$identifier_id"
}

# version_code is an integer on the API. Reject non-numeric input locally so the
# body stays well-typed; the android-only restriction is left to the API.
_identifiers_validate_version_code() {
  [ -n "$1" ] || return 0
  case "$1" in
    ''|*[!0-9]*) die "--version-code must be a positive integer" ;;
  esac
  [ "$1" -ge 1 ] || die "--version-code must be a positive integer"
}

_identifiers_build_body() {
  local body_file="$1"
  local platform="$2"
  local identifier="$3"
  local name="$4"
  local version="$5"
  local version_code="$6"

  local jq_args=(-n)
  local jq_expr='{'
  local first=1

  if [ -n "$platform" ]; then
    jq_args+=(--arg platform "$platform")
    jq_expr="$jq_expr platform: \$platform"
    first=0
  fi
  if [ -n "$identifier" ]; then
    jq_args+=(--arg identifier "$identifier")
    [ "$first" -eq 0 ] && jq_expr="$jq_expr,"
    jq_expr="$jq_expr identifier: \$identifier"
    first=0
  fi
  if [ -n "$name" ]; then
    jq_args+=(--arg name "$name")
    [ "$first" -eq 0 ] && jq_expr="$jq_expr,"
    jq_expr="$jq_expr name: \$name"
    first=0
  fi
  if [ -n "$version" ]; then
    jq_args+=(--arg version "$version")
    [ "$first" -eq 0 ] && jq_expr="$jq_expr,"
    jq_expr="$jq_expr version: \$version"
    first=0
  fi
  if [ -n "$version_code" ]; then
    jq_args+=(--argjson version_code "$version_code")
    [ "$first" -eq 0 ] && jq_expr="$jq_expr,"
    jq_expr="$jq_expr version_code: \$version_code"
    first=0
  fi

  jq_expr="$jq_expr }"
  "$JQ_BIN" "${jq_args[@]}" "$jq_expr" >"$body_file" || die "could not build the request body"
}

_identifiers_resource_format() {
  printf '%s' '{"type":"resource","fields":{"id":"id","platform":"platform","identifier":"identifier","name":"name","version":"version","version_code":"version_code","created_at":"created_at","updated_at":"updated_at"}}'
}


# "apps" subcommands: list, get, create, update, delete, including blueprint attachment.

apps_usage() {
  cat <<'EOF'
Usage:
  appmctl [global options] apps <action> [options]

Actions:
  list                List team applications
  get                 Show application details
  create              Create a new application
  update              Update an application
  delete              Delete an application

Run "appmctl apps <action> --help" for action-specific help.
EOF
}

command_apps() {
  local action="${1:-}"
  shift 2>/dev/null || true

  case "$action" in
    list) _apps_list "$@" ;;
    get) _apps_get "$@" ;;
    create) _apps_create "$@" ;;
    update) _apps_update "$@" ;;
    delete) _apps_delete "$@" ;;
    -h|--help|"") apps_usage; [ -z "$action" ] && return 1; return 0 ;;
    *) die "unknown apps action: $action (use list, get, create, update, delete)" ;;
  esac
}

_apps_list() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl apps list\n'
        return 0
        ;;
      *) die "unknown apps list option: $1" ;;
    esac
  done

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "apps") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_get "apps" || return 1
  local fmt='{"type":"table","fields":["slug","name","created_at"],"headers":["slug","name","created_at"]}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_apps_get() {
  local slug=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl apps get <slug>\n'
        return 0
        ;;
      -*) die "unknown apps get option: $1" ;;
      *)
        [ -z "$slug" ] || die "unexpected argument: $1"
        slug="$1"
        shift
        ;;
    esac
  done

  [ -n "$slug" ] || die "app slug is required"
  validate_slug "app slug" "$slug"

  local path="apps/$slug"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_get "$path" || return 1
  local fmt='{"type":"resource","fields":{"slug":"slug","name":"name","description":"description","blueprint_id":"blueprint_id","created_at":"created_at","updated_at":"updated_at"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_apps_create() {
  local name=""
  local slug=""
  local description=""
  local metadata=""
  local blueprint_id=""
  local body_file

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name) require_value "$1" "$2"; name="$2"; shift 2 ;;
      --name=*) name=${1#*=}; shift ;;
      --slug) require_value "$1" "$2"; slug="$2"; shift 2 ;;
      --slug=*) slug=${1#*=}; shift ;;
      --description) require_value "$1" "$2"; description="$2"; shift 2 ;;
      --description=*) description=${1#*=}; shift ;;
      --metadata) require_value "$1" "$2"; metadata="$2"; shift 2 ;;
      --metadata=*) metadata=${1#*=}; shift ;;
      --blueprint-id) require_value "$1" "$2"; blueprint_id="$2"; shift 2 ;;
      --blueprint-id=*) blueprint_id=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl apps create --name NAME [--slug SLUG] [--description DESC] [--metadata JSON] [--blueprint-id UUID]\n'
        return 0
        ;;
      *) die "unknown apps create option: $1" ;;
    esac
  done

  [ -n "$name" ] || die "--name is required"
  if [ -n "$blueprint_id" ]; then validate_slug "blueprint ID" "$blueprint_id"; fi

  body_file=$(mktemp "${TMPDIR:-/tmp}/appmctl-body.XXXXXX") || die "could not create temp file"
  local jq_args=(-n --arg n "$name")
  local jq_expr='{name: $n'
  if [ -n "$slug" ]; then
    jq_args+=(--arg s "$slug")
    jq_expr="$jq_expr, slug: \$s"
  fi
  if [ -n "$description" ]; then
    jq_args+=(--arg d "$description")
    jq_expr="$jq_expr, description: \$d"
  fi
  if [ -n "$metadata" ]; then
    jq_args+=(--argjson m "$metadata")
    jq_expr="$jq_expr, metadata: \$m"
  fi
  if [ -n "$blueprint_id" ]; then
    jq_args+=(--arg blueprint "$blueprint_id")
    jq_expr="$jq_expr, blueprint_id: \$blueprint"
  fi
  jq_expr="$jq_expr}"
  "$JQ_BIN" "${jq_args[@]}" "$jq_expr" >"$body_file"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "apps") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: POST\n'
    printf 'url: %s\n' "$url"
    printf 'body: %s\n' "$(cat "$body_file")"
    rm -f -- "$body_file"
    return 0
  fi

  api_post "apps" "$body_file" || { rm -f -- "$body_file"; return 1; }
  rm -f -- "$body_file"
  local fmt='{"type":"resource","fields":{"slug":"slug","name":"name","description":"description","created_at":"created_at"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_apps_update() {
  local slug=""
  local name=""
  local description=""
  local metadata=""
  local blueprint_id=""
  local blueprint_id_set=0
  local body_file
  local has_fields=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name) require_value "$1" "$2"; name="$2"; has_fields=1; shift 2 ;;
      --name=*) name=${1#*=}; has_fields=1; shift ;;
      --description) require_value "$1" "$2"; description="$2"; has_fields=1; shift 2 ;;
      --description=*) description=${1#*=}; has_fields=1; shift ;;
      --metadata) require_value "$1" "$2"; metadata="$2"; has_fields=1; shift 2 ;;
      --metadata=*) metadata=${1#*=}; has_fields=1; shift ;;
      --blueprint-id) require_value "$1" "$2"; blueprint_id="$2"; blueprint_id_set=1; has_fields=1; shift 2 ;;
      --blueprint-id=*) blueprint_id=${1#*=}; blueprint_id_set=1; has_fields=1; shift ;;
      --no-blueprint) blueprint_id=""; blueprint_id_set=1; has_fields=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl apps update <slug> [--name NAME] [--description DESC] [--metadata JSON] [--blueprint-id UUID|--no-blueprint]\n'
        return 0
        ;;
      -*) die "unknown apps update option: $1" ;;
      *)
        [ -z "$slug" ] || die "unexpected argument: $1"
        slug="$1"
        shift
        ;;
    esac
  done

  [ -n "$slug" ] || die "app slug is required"
  [ "$has_fields" -eq 1 ] || die "at least one field to update is required"
  validate_slug "app slug" "$slug"
  if [ "$blueprint_id_set" -eq 1 ] && [ -n "$blueprint_id" ]; then validate_slug "blueprint ID" "$blueprint_id"; fi

  body_file=$(mktemp "${TMPDIR:-/tmp}/appmctl-body.XXXXXX") || die "could not create temp file"
  local jq_args=(-n)
  local jq_expr='{'
  local first=1
  if [ -n "$name" ]; then
    jq_args+=(--arg n "$name")
    [ "$first" -eq 0 ] && jq_expr="$jq_expr,"
    jq_expr="$jq_expr name: \$n"
    first=0
  fi
  if [ -n "$description" ]; then
    jq_args+=(--arg d "$description")
    [ "$first" -eq 0 ] && jq_expr="$jq_expr,"
    jq_expr="$jq_expr description: \$d"
    first=0
  fi
  if [ -n "$metadata" ]; then
    jq_args+=(--argjson m "$metadata")
    [ "$first" -eq 0 ] && jq_expr="$jq_expr,"
    jq_expr="$jq_expr metadata: \$m"
    first=0
  fi
  if [ "$blueprint_id_set" -eq 1 ]; then
    [ "$first" -eq 0 ] && jq_expr="$jq_expr,"
    if [ -n "$blueprint_id" ]; then
      jq_args+=(--arg blueprint "$blueprint_id")
      jq_expr="$jq_expr blueprint_id: \$blueprint"
    else
      jq_expr="$jq_expr blueprint_id: null"
    fi
    first=0
  fi
  jq_expr="$jq_expr}"
  "$JQ_BIN" "${jq_args[@]}" "$jq_expr" >"$body_file"

  local path="apps/$slug"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: PATCH\n'
    printf 'url: %s\n' "$url"
    printf 'body: %s\n' "$(cat "$body_file")"
    rm -f -- "$body_file"
    return 0
  fi

  api_patch "$path" "$body_file" || { rm -f -- "$body_file"; return 1; }
  rm -f -- "$body_file"
  printf 'App %s updated\n' "$slug"
}

_apps_delete() {
  local slug=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl apps delete <slug>\n'
        return 0
        ;;
      -*) die "unknown apps delete option: $1" ;;
      *)
        [ -z "$slug" ] || die "unexpected argument: $1"
        slug="$1"
        shift
        ;;
    esac
  done

  [ -n "$slug" ] || die "app slug is required"
  validate_slug "app slug" "$slug"

  local path="apps/$slug"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: DELETE\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_delete "$path" || return 1
  printf 'App %s deleted\n' "$slug"
}


# "blueprints" subcommands: blueprint CRUD/evaluation and nested hook CRUD.

blueprints_usage() {
  cat <<'EOF'
Usage:
  appmctl [global options] blueprints <action> [options]
  appmctl [global options] blueprints hooks <action> [options]

Blueprint actions:
  list                List team blueprints
  get                 Show a blueprint and its hooks
  create              Create a draft or complete blueprint
  update              Update blueprint fields
  delete              Delete a blueprint
  evaluate            Run hooks against attached applications

Hook actions:
  list                List hooks for a blueprint
  get                 Show one hook
  create              Create and evaluate a hook
  update              Update and evaluate a hook
  delete              Delete a hook without changing existing tags

Run "appmctl blueprints <action> --help" or
"appmctl blueprints hooks <action> --help" for action-specific help.
EOF
}

command_blueprints() {
  local action="${1:-}"
  shift 2>/dev/null || true

  case "$action" in
    list) _blueprints_list "$@" ;;
    get) _blueprints_get "$@" ;;
    create) _blueprints_save create "$@" ;;
    update) _blueprints_save update "$@" ;;
    delete) _blueprints_delete "$@" ;;
    evaluate) _blueprints_evaluate "$@" ;;
    hooks) _blueprints_hooks "$@" ;;
    -h|--help|"") blueprints_usage; [ -z "$action" ] && return 1; return 0 ;;
    *) die "unknown blueprints action: $action (use list, get, create, update, delete, evaluate, hooks)" ;;
  esac
}

_blueprints_dry_run() {
  local method="$1"
  local path="$2"
  local body_file="${3:-}"
  local url

  require_config
  url=$(build_url "$path") || return 1
  printf 'dry-run: no request sent\n'
  printf 'method: %s\n' "$method"
  printf 'url: %s\n' "$url"
  if [ -n "$body_file" ]; then
    printf 'body: %s\n' "$(cat "$body_file")"
  fi
}

_blueprints_list() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help) printf 'Usage: appmctl blueprints list\n'; return 0 ;;
      *) die "unknown blueprints list option: $1" ;;
    esac
  done

  if [ "$DRY_RUN" -eq 1 ]; then
    _blueprints_dry_run GET blueprints
    return
  fi

  api_get blueprints || return 1
  local fmt='{"type":"table","fields":["id","name","platforms | join(\", \")","required_files | length","applications_count","hooks_count"],"headers":["id","name","platforms","files","apps","hooks"]}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_blueprints_get() {
  local blueprint_id=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help) printf 'Usage: appmctl blueprints get <blueprint-id>\n'; return 0 ;;
      -*) die "unknown blueprints get option: $1" ;;
      *) [ -z "$blueprint_id" ] || die "unexpected argument: $1"; blueprint_id="$1"; shift ;;
    esac
  done

  [ -n "$blueprint_id" ] || die "blueprint ID is required"
  validate_slug "blueprint ID" "$blueprint_id"
  local path="blueprints/$blueprint_id"

  if [ "$DRY_RUN" -eq 1 ]; then
    _blueprints_dry_run GET "$path"
    return
  fi

  api_get "$path" || return 1
  local fmt='{"type":"resource","fields":{"id":"id","name":"name","description":"description","platforms":"platforms | join(\", \")","required_files":"required_files | join(\", \")","applications":"applications_count","hooks":"hooks_count","created_at":"created_at","updated_at":"updated_at"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_blueprints_save() {
  local mode="$1"
  shift
  local blueprint_id=""
  local name=""
  local description=""
  local schema=""
  local schema_file=""
  local required_files=""
  local platforms=""
  local name_set=0
  local description_set=0
  local schema_set=0
  local required_files_set=0
  local platforms_set=0
  local body_file

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name) require_value "$1" "$2"; name="$2"; name_set=1; shift 2 ;;
      --name=*) name=${1#*=}; name_set=1; shift ;;
      --description) require_value "$1" "$2"; description="$2"; description_set=1; shift 2 ;;
      --description=*) description=${1#*=}; description_set=1; shift ;;
      --clear-description) description=""; description_set=1; shift ;;
      --json-schema) require_value "$1" "$2"; schema="$2"; schema_set=1; shift 2 ;;
      --json-schema=*) schema=${1#*=}; schema_set=1; shift ;;
      --json-schema-file) require_value "$1" "$2"; schema_file="$2"; schema_set=1; shift 2 ;;
      --json-schema-file=*) schema_file=${1#*=}; schema_set=1; shift ;;
      --required-files) require_value "$1" "$2"; required_files="$2"; required_files_set=1; shift 2 ;;
      --required-files=*) required_files=${1#*=}; required_files_set=1; shift ;;
      --platforms) require_value "$1" "$2"; platforms="$2"; platforms_set=1; shift 2 ;;
      --platforms=*) platforms=${1#*=}; platforms_set=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        if [ "$mode" = "create" ]; then
          printf 'Usage: appmctl blueprints create --name NAME [--description DESC] [--json-schema JSON|--json-schema-file FILE] [--required-files JSON] [--platforms JSON]\n'
        else
          printf 'Usage: appmctl blueprints update <blueprint-id> [--name NAME] [--description DESC|--clear-description] [--json-schema JSON|--json-schema-file FILE] [--required-files JSON] [--platforms JSON]\n'
        fi
        return 0
        ;;
      -*) die "unknown blueprints $mode option: $1" ;;
      *)
        [ "$mode" = "update" ] || die "unexpected argument: $1"
        [ -z "$blueprint_id" ] || die "unexpected argument: $1"
        blueprint_id="$1"
        shift
        ;;
    esac
  done

  if [ "$mode" = "create" ]; then
    [ "$name_set" -eq 1 ] && [ -n "$name" ] || die "--name is required"
  else
    [ -n "$blueprint_id" ] || die "blueprint ID is required"
    validate_slug "blueprint ID" "$blueprint_id"
    [ $((name_set + description_set + schema_set + required_files_set + platforms_set)) -gt 0 ] \
      || die "at least one field to update is required"
  fi

  [ -z "$schema" ] || [ -z "$schema_file" ] || die "use only one of --json-schema or --json-schema-file"
  if [ -n "$schema_file" ]; then
    [ -f "$schema_file" ] || die "JSON schema file does not exist: $schema_file"
    schema=$(cat "$schema_file") || die "could not read JSON schema file: $schema_file"
  fi

  require_jq
  if [ "$schema_set" -eq 1 ]; then
    printf '%s' "$schema" | "$JQ_BIN" -e 'type == "object" or . == null' >/dev/null 2>&1 \
      || die "--json-schema must be a JSON object or null"
  fi
  if [ "$required_files_set" -eq 1 ]; then
    printf '%s' "$required_files" | "$JQ_BIN" -e 'type == "array" or . == null' >/dev/null 2>&1 \
      || die "--required-files must be a JSON array or null"
  fi
  if [ "$platforms_set" -eq 1 ]; then
    printf '%s' "$platforms" | "$JQ_BIN" -e 'type == "array" or . == null' >/dev/null 2>&1 \
      || die "--platforms must be a JSON array or null"
  fi

  ensure_tmpdir
  body_file=$(new_temp_file blueprint-body) || die "could not create a request body"
  local jq_args=(-n)
  local jq_expr='{}'
  if [ "$name_set" -eq 1 ]; then jq_args+=(--arg value "$name"); jq_expr="$jq_expr | .name = \$value"; fi
  if [ "$description_set" -eq 1 ]; then
    if [ -n "$description" ]; then jq_args+=(--arg description "$description"); jq_expr="$jq_expr | .description = \$description"
    else jq_expr="$jq_expr | .description = null"; fi
  fi
  if [ "$schema_set" -eq 1 ]; then jq_args+=(--argjson schema "$schema"); jq_expr="$jq_expr | .json_schema = \$schema"; fi
  if [ "$required_files_set" -eq 1 ]; then jq_args+=(--argjson files "$required_files"); jq_expr="$jq_expr | .required_files = \$files"; fi
  if [ "$platforms_set" -eq 1 ]; then jq_args+=(--argjson platforms "$platforms"); jq_expr="$jq_expr | .platforms = \$platforms"; fi
  "$JQ_BIN" "${jq_args[@]}" "$jq_expr" >"$body_file" || die "could not build blueprint request"

  local path="blueprints"
  local method="POST"
  if [ "$mode" = "update" ]; then path="$path/$blueprint_id"; method="PATCH"; fi

  if [ "$DRY_RUN" -eq 1 ]; then
    _blueprints_dry_run "$method" "$path" "$body_file"
    return
  fi

  if [ "$mode" = "create" ]; then api_post "$path" "$body_file" || return 1
  else api_patch "$path" "$body_file" || return 1; fi
  local fmt='{"type":"resource","fields":{"id":"id","name":"name","description":"description","platforms":"platforms | join(\", \")","required_files":"required_files | join(\", \")","applications":"applications_count","hooks":"hooks_count"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_blueprints_delete() {
  local blueprint_id=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      -h|--help) printf 'Usage: appmctl blueprints delete <blueprint-id>\n'; return 0 ;;
      -*) die "unknown blueprints delete option: $1" ;;
      *) [ -z "$blueprint_id" ] || die "unexpected argument: $1"; blueprint_id="$1"; shift ;;
    esac
  done
  [ -n "$blueprint_id" ] || die "blueprint ID is required"
  validate_slug "blueprint ID" "$blueprint_id"
  local path="blueprints/$blueprint_id"
  if [ "$DRY_RUN" -eq 1 ]; then _blueprints_dry_run DELETE "$path"; return; fi
  api_delete "$path" || return 1
  printf 'Blueprint %s deleted\n' "$blueprint_id"
}

_blueprints_evaluate() {
  local blueprint_id=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help) printf 'Usage: appmctl blueprints evaluate <blueprint-id>\n'; return 0 ;;
      -*) die "unknown blueprints evaluate option: $1" ;;
      *) [ -z "$blueprint_id" ] || die "unexpected argument: $1"; blueprint_id="$1"; shift ;;
    esac
  done
  [ -n "$blueprint_id" ] || die "blueprint ID is required"
  validate_slug "blueprint ID" "$blueprint_id"
  local path="blueprints/$blueprint_id/evaluate"
  if [ "$DRY_RUN" -eq 1 ]; then _blueprints_dry_run POST "$path"; return; fi
  api_post "$path" "" || return 1
  local fmt='{"type":"resource","fields":{"evaluated_applications":"evaluated_applications"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_blueprints_hooks() {
  local action="${1:-}"
  shift 2>/dev/null || true
  case "$action" in
    list) _blueprints_hooks_list "$@" ;;
    get) _blueprints_hooks_get "$@" ;;
    create) _blueprints_hook_save create "$@" ;;
    update) _blueprints_hook_save update "$@" ;;
    delete) _blueprints_hooks_delete "$@" ;;
    -h|--help|"")
      cat <<'EOF'
Usage:
  appmctl blueprints hooks list <blueprint-id>
  appmctl blueprints hooks get <blueprint-id> <hook-id>
  appmctl blueprints hooks create <blueprint-id> --name NAME --condition CONDITION --actions JSON
  appmctl blueprints hooks update <blueprint-id> <hook-id> [fields]
  appmctl blueprints hooks delete <blueprint-id> <hook-id>
EOF
      [ -z "$action" ] && return 1
      return 0
      ;;
    *) die "unknown blueprints hooks action: $action (use list, get, create, update, delete)" ;;
  esac
}

_blueprints_hooks_list() {
  local blueprint_id=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help) printf 'Usage: appmctl blueprints hooks list <blueprint-id>\n'; return 0 ;;
      -*) die "unknown blueprints hooks list option: $1" ;;
      *) [ -z "$blueprint_id" ] || die "unexpected argument: $1"; blueprint_id="$1"; shift ;;
    esac
  done
  [ -n "$blueprint_id" ] || die "blueprint ID is required"
  validate_slug "blueprint ID" "$blueprint_id"
  local path="blueprints/$blueprint_id/hooks"
  if [ "$DRY_RUN" -eq 1 ]; then _blueprints_dry_run GET "$path"; return; fi
  api_get "$path" || return 1
  local fmt='{"type":"table","fields":["id","name","condition","actions | length","enabled"],"headers":["id","name","condition","actions","enabled"]}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_blueprints_hooks_get() {
  local blueprint_id=""
  local hook_id=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help) printf 'Usage: appmctl blueprints hooks get <blueprint-id> <hook-id>\n'; return 0 ;;
      -*) die "unknown blueprints hooks get option: $1" ;;
      *)
        if [ -z "$blueprint_id" ]; then blueprint_id="$1"
        elif [ -z "$hook_id" ]; then hook_id="$1"
        else die "unexpected argument: $1"; fi
        shift
        ;;
    esac
  done
  [ -n "$blueprint_id" ] || die "blueprint ID is required"
  [ -n "$hook_id" ] || die "hook ID is required"
  validate_slug "blueprint ID" "$blueprint_id"
  validate_slug "hook ID" "$hook_id"
  local path="blueprints/$blueprint_id/hooks/$hook_id"
  if [ "$DRY_RUN" -eq 1 ]; then _blueprints_dry_run GET "$path"; return; fi
  api_get "$path" || return 1
  local fmt='{"type":"resource","fields":{"id":"id","blueprint_id":"blueprint_id","name":"name","condition":"condition","actions":"actions | length","enabled":"enabled","created_at":"created_at","updated_at":"updated_at"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_blueprints_hook_save() {
  local mode="$1"
  shift
  local blueprint_id=""
  local hook_id=""
  local name=""
  local condition=""
  local condition_config=""
  local actions=""
  local actions_file=""
  local enabled=""
  local name_set=0
  local condition_set=0
  local condition_config_set=0
  local actions_set=0
  local enabled_set=0
  local body_file

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name) require_value "$1" "$2"; name="$2"; name_set=1; shift 2 ;;
      --name=*) name=${1#*=}; name_set=1; shift ;;
      --condition) require_value "$1" "$2"; condition="$2"; condition_set=1; shift 2 ;;
      --condition=*) condition=${1#*=}; condition_set=1; shift ;;
      --condition-config) require_value "$1" "$2"; condition_config="$2"; condition_config_set=1; shift 2 ;;
      --condition-config=*) condition_config=${1#*=}; condition_config_set=1; shift ;;
      --actions) require_value "$1" "$2"; actions="$2"; actions_set=1; shift 2 ;;
      --actions=*) actions=${1#*=}; actions_set=1; shift ;;
      --actions-file) require_value "$1" "$2"; actions_file="$2"; actions_set=1; shift 2 ;;
      --actions-file=*) actions_file=${1#*=}; actions_set=1; shift ;;
      --enabled) require_value "$1" "$2"; enabled="$2"; enabled_set=1; shift 2 ;;
      --enabled=*) enabled=${1#*=}; enabled_set=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        if [ "$mode" = "create" ]; then
          printf 'Usage: appmctl blueprints hooks create <blueprint-id> --name NAME --condition CONDITION --actions JSON|--actions-file FILE [--condition-config JSON] [--enabled true|false]\n'
        else
          printf 'Usage: appmctl blueprints hooks update <blueprint-id> <hook-id> [--name NAME] [--condition CONDITION] [--condition-config JSON] [--actions JSON|--actions-file FILE] [--enabled true|false]\n'
        fi
        return 0
        ;;
      -*) die "unknown blueprints hooks $mode option: $1" ;;
      *)
        if [ -z "$blueprint_id" ]; then blueprint_id="$1"
        elif [ "$mode" = "update" ] && [ -z "$hook_id" ]; then hook_id="$1"
        else die "unexpected argument: $1"; fi
        shift
        ;;
    esac
  done

  [ -n "$blueprint_id" ] || die "blueprint ID is required"
  validate_slug "blueprint ID" "$blueprint_id"
  if [ "$mode" = "create" ]; then
    [ "$name_set" -eq 1 ] && [ -n "$name" ] || die "--name is required"
    [ "$condition_set" -eq 1 ] && [ -n "$condition" ] || die "--condition is required"
    [ "$actions_set" -eq 1 ] || die "--actions or --actions-file is required"
  else
    [ -n "$hook_id" ] || die "hook ID is required"
    validate_slug "hook ID" "$hook_id"
    [ $((name_set + condition_set + condition_config_set + actions_set + enabled_set)) -gt 0 ] \
      || die "at least one field to update is required"
  fi

  [ -z "$actions" ] || [ -z "$actions_file" ] || die "use only one of --actions or --actions-file"
  if [ -n "$actions_file" ]; then
    [ -f "$actions_file" ] || die "actions file does not exist: $actions_file"
    actions=$(cat "$actions_file") || die "could not read actions file: $actions_file"
  fi

  require_jq
  if [ "$condition_config_set" -eq 1 ]; then
    printf '%s' "$condition_config" | "$JQ_BIN" -e 'type == "object" or . == null' >/dev/null 2>&1 \
      || die "--condition-config must be a JSON object or null"
  fi
  if [ "$actions_set" -eq 1 ]; then
    printf '%s' "$actions" | "$JQ_BIN" -e 'type == "array" and length > 0' >/dev/null 2>&1 \
      || die "--actions must be a non-empty JSON array"
  fi
  if [ "$enabled_set" -eq 1 ]; then
    case "$enabled" in true|false) ;; *) die "--enabled must be true or false" ;; esac
  fi

  ensure_tmpdir
  body_file=$(new_temp_file blueprint-hook-body) || die "could not create a request body"
  local jq_args=(-n)
  local jq_expr='{}'
  if [ "$name_set" -eq 1 ]; then jq_args+=(--arg name "$name"); jq_expr="$jq_expr | .name = \$name"; fi
  if [ "$condition_set" -eq 1 ]; then jq_args+=(--arg condition "$condition"); jq_expr="$jq_expr | .condition = \$condition"; fi
  if [ "$condition_config_set" -eq 1 ]; then jq_args+=(--argjson config "$condition_config"); jq_expr="$jq_expr | .condition_config = \$config"; fi
  if [ "$actions_set" -eq 1 ]; then jq_args+=(--argjson actions "$actions"); jq_expr="$jq_expr | .actions = \$actions"; fi
  if [ "$enabled_set" -eq 1 ]; then jq_args+=(--argjson enabled "$enabled"); jq_expr="$jq_expr | .enabled = \$enabled"; fi
  "$JQ_BIN" "${jq_args[@]}" "$jq_expr" >"$body_file" || die "could not build hook request"

  local path="blueprints/$blueprint_id/hooks"
  local method="POST"
  if [ "$mode" = "update" ]; then path="$path/$hook_id"; method="PATCH"; fi
  if [ "$DRY_RUN" -eq 1 ]; then _blueprints_dry_run "$method" "$path" "$body_file"; return; fi
  if [ "$mode" = "create" ]; then api_post "$path" "$body_file" || return 1
  else api_patch "$path" "$body_file" || return 1; fi
  local fmt='{"type":"resource","fields":{"id":"id","blueprint_id":"blueprint_id","name":"name","condition":"condition","actions":"actions | length","enabled":"enabled"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_blueprints_hooks_delete() {
  local blueprint_id=""
  local hook_id=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      -h|--help) printf 'Usage: appmctl blueprints hooks delete <blueprint-id> <hook-id>\n'; return 0 ;;
      -*) die "unknown blueprints hooks delete option: $1" ;;
      *)
        if [ -z "$blueprint_id" ]; then blueprint_id="$1"
        elif [ -z "$hook_id" ]; then hook_id="$1"
        else die "unexpected argument: $1"; fi
        shift
        ;;
    esac
  done
  [ -n "$blueprint_id" ] || die "blueprint ID is required"
  [ -n "$hook_id" ] || die "hook ID is required"
  validate_slug "blueprint ID" "$blueprint_id"
  validate_slug "hook ID" "$hook_id"
  local path="blueprints/$blueprint_id/hooks/$hook_id"
  if [ "$DRY_RUN" -eq 1 ]; then _blueprints_dry_run DELETE "$path"; return; fi
  api_delete "$path" || return 1
  printf 'Blueprint hook %s deleted\n' "$hook_id"
}


# "credentials" subcommands: list, get, create, update, delete, download, upload,
# verify, types.

credentials_usage() {
  cat <<'EOF'
Usage:
  appmctl [global options] credentials <action> [options]

Actions:
  list                List credentials for an app
  get                 Show credential details
  create              Create a credential
  update              Update a credential
  delete              Delete a credential
  download            Download a credential file
  upload              Upload a credential file
  verify              Report a verification verdict for an external vault reference
  types               List available credential types

Options:
  --app APP           App slug (default: APP_MANAGER_APP)
  --credential-id ID  Credential ID (required for get, update, delete, download, upload)
  --type TYPE         Credential type slug (create)
  --profile PROFILE   Build profile (create)
  --data-file FILE    Credential data as JSON from FILE or stdin (-) (create, update)
  --data JSON         Credential data as inline JSON (deprecated; may leak via process arguments)
  --file FILE         Credential file to upload (create, upload)
  --status STATUS     Reported verdict: verified or failed (verify)
  --error TEXT        Why resolution failed; required with --status failed (verify)
  --expires-at DATE   Expiry discovered in the vault; only with --status verified (verify)
  --metadata JSON     JSON object of string values describing the resolved secret (verify)

Run "appmctl credentials <action> --help" for action-specific help.
EOF
}

command_credentials() {
  local action="${1:-}"
  shift 2>/dev/null || true

  case "$action" in
    list) _credentials_list "$@" ;;
    get) _credentials_get "$@" ;;
    create) _credentials_create "$@" ;;
    update) _credentials_update "$@" ;;
    delete) _credentials_delete "$@" ;;
    download) _credentials_download "$@" ;;
    upload) _credentials_upload "$@" ;;
    verify) _credentials_verify "$@" ;;
    types) _credentials_types "$@" ;;
    -h|--help|"") credentials_usage; [ -z "$action" ] && return 1; return 0 ;;
    *) die "unknown credentials action: $action (use list, get, create, update, delete, download, upload, verify, types)" ;;
  esac
}

_credentials_list() {
  local app="${APP:-}"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl credentials list [--app APP]\n'
        return 0
        ;;
      *) die "unknown credentials list option: $1" ;;
    esac
  done

  APP="$app"
  require_app
  local path="apps/$APP/credentials"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_get "$path" || return 1
  local fmt='{"type":"table","fields":["id","type","name","expires_at"],"headers":["id","type","name","expires_at"]}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_credentials_get() {
  local app="${APP:-}"
  local cred_id=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl credentials get [--app APP] <credential-id>\n'
        return 0
        ;;
      -*) die "unknown credentials get option: $1" ;;
      *)
        [ -z "$cred_id" ] || die "unexpected argument: $1"
        cred_id="$1"; shift ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$cred_id" ] || die "credential ID is required"

  local path="apps/$APP/credentials/$cred_id"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_get "$path" || return 1
  local fmt='{"type":"resource","fields":{"id":"id","type":"type","name":"name","profiles":"profiles // [] | map(.type) | join(\", \")","expires_at":"expires_at","file":"file.name","created_at":"created_at","updated_at":"updated_at"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_credentials_create() {
  local app="${APP:-}"
  local cred_type=""
  local profile=""
  local data=""
  local data_file=""
  local file_path=""
  local body_file

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --type) require_value "$1" "$2"; cred_type="$2"; shift 2 ;;
      --type=*) cred_type=${1#*=}; shift ;;
      --profile) require_value "$1" "$2"; profile="$2"; shift 2 ;;
      --profile=*) profile=${1#*=}; shift ;;
      --data) require_value "$1" "$2"; data="$2"; shift 2 ;;
      --data=*) data=${1#*=}; shift ;;
      --data-file) require_value "$1" "$2"; data_file="$2"; shift 2 ;;
      --data-file=*) data_file=${1#*=}; shift ;;
      --file) require_value "$1" "$2"; file_path="$2"; shift 2 ;;
      --file=*) file_path=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl credentials create [--app APP] --type TYPE --profile PROFILE [--data-file FILE|-] [--file FILE]\n'
        return 0
        ;;
      *) die "unknown credentials create option: $1" ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$cred_type" ] || die "--type is required"
  [ -n "$profile" ] || die "--profile is required"
  [ -z "$data" ] || [ -z "$data_file" ] || die "use only one of --data or --data-file"

  ensure_tmpdir
  body_file=$(new_temp_file credential-body) || die "could not create temp file"
  chmod 600 "$body_file" 2>/dev/null || true
  local jq_args=(-n --arg t "$cred_type" --arg p "$profile")
  local jq_expr='{credential_type: {slug: $t}, build_profile: $p'
  if [ -n "$data" ] || [ -n "$data_file" ]; then
    local secret_file
    if [ -n "$data_file" ] && [ "$data_file" != "-" ]; then
      [ -f "$data_file" ] || die "credential data file does not exist: $data_file"
      secret_file="$data_file"
    else
      secret_file=$(new_temp_file credential-data) || die "could not create credential data file"
      chmod 600 "$secret_file" 2>/dev/null || true
      if [ "$data_file" = "-" ]; then
        cat >"$secret_file"
      else
        printf '%s' "$data" >"$secret_file"
      fi
    fi
    jq_args+=(--slurpfile d "$secret_file")
    jq_expr="$jq_expr, data: \$d[0]"
  fi
  jq_expr="$jq_expr}"
  "$JQ_BIN" "${jq_args[@]}" "$jq_expr" >"$body_file"

  local path="apps/$APP/credentials"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: POST\n'
    printf 'url: %s\n' "$url"
    printf 'body: credential JSON (%s bytes; redacted)\n' "$(wc -c <"$body_file" | tr -d '[:space:]')"
    rm -f -- "$body_file"
    return 0
  fi

  api_post "$path" "$body_file" || { rm -f -- "$body_file"; return 1; }
  rm -f -- "$body_file"
  local fmt='{"type":"resource","fields":{"id":"id","type":"credential_type.slug","profile":"build_profile","created_at":"created_at"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_credentials_update() {
  local app="${APP:-}"
  local cred_id=""
  local data=""
  local data_file=""
  local body_file
  local has_fields=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --data) require_value "$1" "$2"; data="$2"; has_fields=1; shift 2 ;;
      --data=*) data=${1#*=}; has_fields=1; shift ;;
      --data-file) require_value "$1" "$2"; data_file="$2"; has_fields=1; shift 2 ;;
      --data-file=*) data_file=${1#*=}; has_fields=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl credentials update [--app APP] <credential-id> --data-file FILE|-\n'
        return 0
        ;;
      -*) die "unknown credentials update option: $1" ;;
      *)
        [ -z "$cred_id" ] || die "unexpected argument: $1"
        cred_id="$1"; shift ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$cred_id" ] || die "credential ID is required"
  [ "$has_fields" -eq 1 ] || die "at least one field to update is required"
  [ -z "$data" ] || [ -z "$data_file" ] || die "use only one of --data or --data-file"

  ensure_tmpdir
  body_file=$(new_temp_file credential-body) || die "could not create temp file"
  chmod 600 "$body_file" 2>/dev/null || true
  local secret_file
  if [ -n "$data_file" ] && [ "$data_file" != "-" ]; then
    [ -f "$data_file" ] || die "credential data file does not exist: $data_file"
    secret_file="$data_file"
  else
    secret_file=$(new_temp_file credential-data) || die "could not create credential data file"
    chmod 600 "$secret_file" 2>/dev/null || true
    if [ "$data_file" = "-" ]; then
      cat >"$secret_file"
    else
      printf '%s' "$data" >"$secret_file"
    fi
  fi
  "$JQ_BIN" -n --slurpfile d "$secret_file" '{data: $d[0]}' >"$body_file"

  local path="apps/$APP/credentials/$cred_id"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: PATCH\n'
    printf 'url: %s\n' "$url"
    printf 'body: credential JSON (%s bytes; redacted)\n' "$(wc -c <"$body_file" | tr -d '[:space:]')"
    rm -f -- "$body_file"
    return 0
  fi

  api_patch "$path" "$body_file" || { rm -f -- "$body_file"; return 1; }
  rm -f -- "$body_file"
  printf 'Credential %s updated\n' "$cred_id"
}

_credentials_delete() {
  local app="${APP:-}"
  local cred_id=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl credentials delete [--app APP] <credential-id>\n'
        return 0
        ;;
      -*) die "unknown credentials delete option: $1" ;;
      *)
        [ -z "$cred_id" ] || die "unexpected argument: $1"
        cred_id="$1"; shift ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$cred_id" ] || die "credential ID is required"

  local path="apps/$APP/credentials/$cred_id"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: DELETE\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_delete "$path" || return 1
  printf 'Credential %s deleted\n' "$cred_id"
}

_credentials_download() {
  local app="${APP:-}"
  local cred_id=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl credentials download [--app APP] <credential-id> [-o FILE]\n'
        return 0
        ;;
      -*) die "unknown credentials download option: $1" ;;
      *)
        [ -z "$cred_id" ] || die "unexpected argument: $1"
        cred_id="$1"; shift ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$cred_id" ] || die "credential ID is required"

  local path="apps/$APP/credentials/$cred_id/file"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  check_output_destination
  api_get "$path" || return 1
  emit_response
}

_credentials_upload() {
  local app="${APP:-}"
  local cred_id=""
  local file_path=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --file) require_value "$1" "$2"; file_path="$2"; shift 2 ;;
      --file=*) file_path=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl credentials upload [--app APP] <credential-id> --file FILE\n'
        return 0
        ;;
      -*) die "unknown credentials upload option: $1" ;;
      *)
        [ -z "$cred_id" ] || die "unexpected argument: $1"
        cred_id="$1"; shift ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$cred_id" ] || die "credential ID is required"
  [ -n "$file_path" ] || die "--file is required"
  [ -f "$file_path" ] || die "file does not exist: $file_path"

  local path="apps/$APP/credentials/$cred_id/file"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: POST\n'
    printf 'url: %s\n' "$url"
    printf 'file: %s\n' "$file_path"
    return 0
  fi

  require_curl
  ensure_tmpdir
  local url
  url=$(build_url "$path") || return 1

  reset_request
  REQUEST_BODY_KIND="multipart"
  REQUEST_FILES+=("file=$file_path")

  perform_request POST "$url" || return 1
  printf 'Credential file uploaded to %s\n' "$cred_id"
}

# App Manager never reaches into an external vault itself, so the verdict has to
# come from whoever can: the build. This action only transmits that verdict.
_credentials_verify() {
  local app="${APP:-}"
  local cred_id=""
  local status=""
  local error_text=""
  local expires_at=""
  local metadata=""
  local body_file

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --app) require_value "$1" "$2"; app="$2"; shift 2 ;;
      --app=*) app=${1#*=}; shift ;;
      --status) require_value "$1" "$2"; status="$2"; shift 2 ;;
      --status=*) status=${1#*=}; shift ;;
      --error) require_value "$1" "$2"; error_text="$2"; shift 2 ;;
      --error=*) error_text=${1#*=}; shift ;;
      --expires-at) require_value "$1" "$2"; expires_at="$2"; shift 2 ;;
      --expires-at=*) expires_at=${1#*=}; shift ;;
      --metadata) require_value "$1" "$2"; metadata="$2"; shift 2 ;;
      --metadata=*) metadata=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl credentials verify [--app APP] <credential-id> --status verified|failed\n'
        printf '                                  [--error TEXT] [--expires-at DATE] [--metadata JSON]\n'
        return 0
        ;;
      -*) die "unknown credentials verify option: $1" ;;
      *)
        [ -z "$cred_id" ] || die "unexpected argument: $1"
        cred_id="$1"; shift ;;
    esac
  done

  APP="$app"
  require_app
  [ -n "$cred_id" ] || die "credential ID is required"

  # Mirror the API's rules rather than discovering them as a 422: a build that
  # passed contradictory flags should learn so before it spends a request.
  case "$status" in
    verified|failed) ;;
    "") die "--status is required (verified or failed)" ;;
    *) die "--status must be verified or failed, not $status" ;;
  esac

  if [ "$status" = "failed" ]; then
    [ -n "$error_text" ] || die "--error is required when --status is failed"
    [ -z "$expires_at" ] || die "--expires-at cannot be combined with --status failed"
  else
    [ -z "$error_text" ] || die "--error is only accepted when --status is failed"
  fi

  local metadata_json=""
  if [ -n "$metadata" ]; then
    metadata_json=$(
      printf '%s' "$metadata" |
        "$JQ_BIN" -c 'if type == "object" then . else error("not an object") end' 2>/dev/null
    ) || die "--metadata must be a JSON object of string values"
  fi

  ensure_tmpdir
  body_file=$(new_temp_file verification-body) || die "could not create temp file"

  local jq_args=(--arg st "$status")
  local jq_filter='{status: $st'

  if [ -n "$error_text" ]; then
    jq_args+=(--arg err "$error_text")
    jq_filter="$jq_filter, error: \$err"
  fi

  if [ -n "$expires_at" ]; then
    jq_args+=(--arg exp "$expires_at")
    jq_filter="$jq_filter, expires_at: \$exp"
  fi

  if [ -n "$metadata_json" ]; then
    jq_args+=(--argjson meta "$metadata_json")
    jq_filter="$jq_filter, metadata: \$meta"
  fi

  jq_filter="$jq_filter}"
  "$JQ_BIN" -nc "${jq_args[@]}" "$jq_filter" >"$body_file"

  local path="apps/$APP/credentials/$cred_id/verification"

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "$path") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: POST\n'
    printf 'url: %s\n' "$url"
    printf 'body: %s\n' "$(cat "$body_file")"
    rm -f -- "$body_file"
    return 0
  fi

  api_post "$path" "$body_file" || { rm -f -- "$body_file"; return 1; }
  rm -f -- "$body_file"
  local fmt='{"type":"resource","fields":{"provider":"provider","resource":"resource","status":"verification.status","verified_at":"verification.verified_at","error":"verification.error","metadata":"metadata // empty | tojson","metadata_version":"metadata_version","metadata_source":"metadata_source"}}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_credentials_types() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl credentials types\n'
        return 0
        ;;
      *) die "unknown credentials types option: $1" ;;
    esac
  done

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "credential-types") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_get "credential-types" || return 1
  local fmt='{"type":"table","fields":["slug","name","platform"],"headers":["slug","name","platform"]}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}


# "integrations" subcommands: list, get, repos, workflows, refs.

integrations_usage() {
  cat <<'EOF'
Usage:
  appmctl [global options] integrations <action> [options]

Actions:
  list                List team integrations
  get                 Show integration details
  repos               List repositories for an integration
  workflows           List workflows for an integration
  refs                List refs for an integration

Run "appmctl integrations <action> --help" for action-specific help.
EOF
}

command_integrations() {
  local action="${1:-}"
  shift 2>/dev/null || true

  case "$action" in
    list) _integrations_list "$@" ;;
    get) _integrations_get "$@" ;;
    repos) _integrations_repos "$@" ;;
    workflows) _integrations_workflows "$@" ;;
    refs) _integrations_refs "$@" ;;
    -h|--help|"") integrations_usage; [ -z "$action" ] && return 1; return 0 ;;
    *) die "unknown integrations action: $action (use list, get, repos, workflows, refs)" ;;
  esac
}

_require_integration_id() {
  local var_name="$1"
  eval "[ -n \"\$$var_name\" ] || die \"--integration-id is required\""
}

_integrations_list() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl integrations list\n'
        return 0
        ;;
      *) die "unknown integrations list option: $1" ;;
    esac
  done

  if [ "$DRY_RUN" -eq 1 ]; then
    local url
    require_config
    url=$(build_url "integrations") || return 1
    printf 'dry-run: no request sent\n'
    printf 'method: GET\n'
    printf 'url: %s\n' "$url"
    return 0
  fi

  api_get "integrations" || return 1
  local fmt='{"type":"table","fields":["id","provider","name","created_at"],"headers":["id","provider","name","created_at"]}'
  emit_formatted_response "$LAST_RESPONSE_FILE" "$fmt"
}

_integrations_get() {
  local integration_id=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1; shift ;;
      --json) PRETTY_JSON=1; shift ;;
      -o|--output) require_value "$1" "$2"; OUTPUT_FILE="$2"; shift 2 ;;
      --force) FORCE_OUTPUT=1; shift ;;
      -h|--help)
        printf 'Usage: appmctl integrations get <integration-id>\n'
        return 0
        ;;
      -*) die "unknown integrations get option: $1" ;;
      *)
        [ -z "$integration_id" ] || die "unexpected argument: $1"
        integration_id="$1"; shift ;;

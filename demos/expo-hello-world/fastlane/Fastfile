require "json"
require "fileutils"
require "shellwords"

CONTEXT_PATH = File.expand_path("context.json", __dir__)
CREDENTIALS_PATH = File.expand_path("../credentials.json", __dir__)
PROJECT_ROOT = File.expand_path("..", __dir__)

IOS_KEYCHAIN = File.expand_path("build.keychain-db", __dir__)
IOS_KEYCHAIN_PASSWORD = "fastlane-build"

def load_context
  UI.user_error!("fastlane/context.json is missing. Run `npm run prepare` first.") unless File.exist?(CONTEXT_PATH)
  JSON.parse(File.read(CONTEXT_PATH))
end

def load_credentials
  UI.user_error!("credentials.json is missing. Run `npm run prepare` first.") unless File.exist?(CREDENTIALS_PATH)
  JSON.parse(File.read(CREDENTIALS_PATH))
end

def deploy_allowed?(options)
  options[:submit] == true || ENV["APP_MANAGER_ALLOW_DEPLOY"] == "1"
end

def profile_metadata(profile_path)
  decoded = "#{profile_path}.plist"
  begin
    sh("bash", "-c", "security cms -D -i #{profile_path.shellescape} > #{decoded.shellescape}")
    {
      uuid: sh("plutil", "-extract", "UUID", "raw", "-o", "-", decoded).strip,
      name: sh("plutil", "-extract", "Name", "raw", "-o", "-", decoded).strip,
      team: sh("plutil", "-extract", "TeamIdentifier.0", "raw", "-o", "-", decoded).strip,
    }
  ensure
    File.delete(decoded) if File.exist?(decoded)
  end
end

def setup_ios_signing(credentials, signing)
  cert = credentials.dig("ios", "distributionCertificate")
  UI.user_error!("No iOS distribution certificate in credentials.json") unless cert
  cert_path = File.expand_path(cert["path"], PROJECT_ROOT)
  profile_path = File.expand_path(credentials.dig("ios", "provisioningProfilePath"), PROJECT_ROOT)
  UI.user_error!("iOS provisioning profile is missing") unless File.exist?(profile_path)

  sh("security", "delete-keychain", IOS_KEYCHAIN) if File.exist?(IOS_KEYCHAIN)
  # log: false on commands carrying the keychain or certificate password
  sh("security", "create-keychain", "-p", IOS_KEYCHAIN_PASSWORD, IOS_KEYCHAIN, log: false)
  sh("security", "set-keychain-settings", IOS_KEYCHAIN)
  sh("security", "unlock-keychain", "-p", IOS_KEYCHAIN_PASSWORD, IOS_KEYCHAIN, log: false)
  sh("security", "import", cert_path, "-k", IOS_KEYCHAIN, "-P", cert["password"],
     "-T", "/usr/bin/codesign", "-T", "/usr/bin/security", "-A", log: false)
  sh("security", "set-key-partition-list", "-S", "apple-tool:,apple:",
     "-s", "-k", IOS_KEYCHAIN_PASSWORD, IOS_KEYCHAIN, log: false)

  # Record the search list BEFORE mutating it, so teardown can always restore it.
  signing[:previous_keychains] = sh("security", "list-keychains", "-d", "user").scan(/"([^"]+)"/).flatten
  sh("security", "list-keychains", "-d", "user", "-s", IOS_KEYCHAIN, *signing[:previous_keychains])

  identity = sh("security", "find-identity", "-v", "-p", "codesigning", IOS_KEYCHAIN)[/\b([0-9A-F]{40})\b/, 1]
  UI.user_error!("No valid iOS signing identity after import (missing WWDR/root in system keychain?)") unless identity

  meta = profile_metadata(profile_path)
  profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
  FileUtils.mkdir_p(profiles_dir)
  installed_profile = File.join(profiles_dir, "#{meta[:uuid]}.mobileprovision")
  FileUtils.cp(profile_path, installed_profile)
  signing[:installed_profile] = installed_profile

  { identity: identity, profile_name: meta[:name], team: meta[:team] }
end

def teardown_ios_signing(signing)
  return unless signing
  if signing[:previous_keychains] && ! signing[:previous_keychains].empty?
    sh("security", "list-keychains", "-d", "user", "-s", *signing[:previous_keychains])
  end
  sh("security", "delete-keychain", IOS_KEYCHAIN) if File.exist?(IOS_KEYCHAIN)
  File.delete(signing[:installed_profile]) if signing[:installed_profile] && File.exist?(signing[:installed_profile])
end

before_all do
  unless Dir.exist?(File.join(PROJECT_ROOT, "android")) && Dir.exist?(File.join(PROJECT_ROOT, "ios"))
    UI.message("Native projects missing; running `expo prebuild`.")
    Dir.chdir(PROJECT_ROOT) { sh("npx", "expo", "prebuild") }
  end
end

desc "Build a signed Android release AAB"
lane :build_android do
  context = load_context
  keystore = load_credentials.dig("android", "keystore")
  UI.user_error!("No Android keystore in credentials.json") unless keystore

  gradle(
    project_dir: File.join(PROJECT_ROOT, "android"),
    task: "bundle",
    build_type: "Release",
    properties: {
      "android.injected.signing.store.file" => File.expand_path(keystore["keystorePath"], PROJECT_ROOT),
      "android.injected.signing.store.password" => keystore["keystorePassword"],
      "android.injected.signing.key.alias" => keystore["keyAlias"],
      "android.injected.signing.key.password" => keystore["keyPassword"],
    },
  )
  UI.success("Built #{context.dig('android', 'package')} release bundle.")
end

desc "Build and (optionally) upload Android to Google Play internal track"
lane :deploy_android do |options|
  build_android
  context = load_context
  json_key = context.dig("android", "googlePlayJsonKeyPath")

  if json_key.nil?
    UI.important("No Google Play service account in context.json; stopping at the signed artifact.")
    next
  end
  unless deploy_allowed?(options)
    UI.important("Deploy not requested (pass submit:true or set APP_MANAGER_ALLOW_DEPLOY=1); stopping at the signed artifact.")
    next
  end

  upload_to_play_store(
    package_name: context.dig("android", "package"),
    json_key: File.expand_path(json_key, PROJECT_ROOT),
    track: "internal",
    aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
  )
end

desc "Build a signed iOS release IPA"
lane :build_ios do
  context = load_context
  credentials = load_credentials
  workspace = Dir[File.join(PROJECT_ROOT, "ios", "*.xcworkspace")].first
  UI.user_error!("No Xcode workspace found; run `expo prebuild` first.") if workspace.nil?

  bundle_id = context.dig("ios", "bundleIdentifier")
  signing = {}
  begin
    info = setup_ios_signing(credentials, signing)
    build_app(
      workspace: workspace,
      scheme: File.basename(workspace, ".xcworkspace"),
      export_method: "app-store",
      output_directory: File.join(PROJECT_ROOT, "build"),
      xcargs: %Q(CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=#{info[:team]} ) +
              %Q(PROVISIONING_PROFILE_SPECIFIER="#{info[:profile_name]}" ) +
              %Q(CODE_SIGN_IDENTITY=#{info[:identity]}),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: info[:team],
        provisioningProfiles: { bundle_id => info[:profile_name] },
        signingCertificate: "Apple Distribution",
      },
    )
    UI.success("Built #{bundle_id} signed release IPA.")
  ensure
    teardown_ios_signing(signing)
  end
end

desc "Build and (optionally) upload iOS to TestFlight"
lane :deploy_ios do |options|
  build_ios
  context = load_context
  api_key = context.dig("ios", "appStoreApiKey")

  if api_key.nil?
    UI.important("No App Store Connect API key in context.json; stopping at the signed artifact.")
    next
  end
  unless deploy_allowed?(options)
    UI.important("Deploy not requested (pass submit:true or set APP_MANAGER_ALLOW_DEPLOY=1); stopping at the signed artifact.")
    next
  end

  key = app_store_connect_api_key(
    key_id: api_key["keyId"],
    issuer_id: api_key["issuerId"],
    key_filepath: File.expand_path(api_key["path"], PROJECT_ROOT),
  )
  upload_to_testflight(api_key: key)
end

desc "Build one or more platforms (platforms:\"ios,android\")"
lane :build do |options|
  platforms = (options[:platforms] || "ios,android").split(",").map(&:strip)
  build_android if platforms.include?("android")
  build_ios if platforms.include?("ios")
end

desc "Deploy one or more platforms (platforms:\"ios,android\" submit:true)"
lane :deploy do |options|
  platforms = (options[:platforms] || "ios,android").split(",").map(&:strip)
  deploy_android(options) if platforms.include?("android")
  deploy_ios(options) if platforms.include?("ios")
end

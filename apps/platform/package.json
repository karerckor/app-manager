{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:design": "node --test tests/design/*.test.js",
        "design:lint": "node scripts/design/design-lint.mjs resources/js/Components/ui resources/js/design resources/js/Components/AppShell.svelte resources/js/Components/WorkspacePage.svelte resources/js/Pages/Installer",
        "verify": "npm run test:design && npm run design:lint && vite build"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "5.3.0",
        "@fontsource/ibm-plex-sans": "5.3.0",
        "@fontsource/ibm-plex-sans-condensed": "5.3.0",
        "@inertiajs/svelte": "^3.6.1",
        "@lucide/svelte": "^1.28.0",
        "svelte": "^5.56.4"
    }
}

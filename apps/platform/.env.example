APP_NAME="App Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app_manager
DB_USERNAME=app_manager
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

MEDIA_STORAGE_DRIVER=local
MEDIA_QUEUE=default
MEDIA_MAX_FILE_SIZE_KB=102400
BUILD_LOG_RETENTION_DAYS=30
MEDIA_LOCAL_ROOT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_URL=
MEDIA_S3_PREFIX=
MEDIA_S3_USE_PATH_STYLE_ENDPOINT=false
MEDIA_S3_OBJECT_ACL=bucket-owner-full-control
MEDIA_S3_SERVER_SIDE_ENCRYPTION=AES256
MEDIA_S3_KMS_KEY_ID=

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_DISTRIBUTION=self-hosted
SELF_HOSTED_INSTALLER_ENABLED=true

INTEGRATIONS_ENABLED=false
WEBHOOKS_ALLOW_PRIVATE_ADDRESSES=false
GITHUB_INTEGRATION_ENABLED=false
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# PEM contents with escaped newlines or an absolute path to the PEM file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_CONNECTION_STATE_TTL=600
GITLAB_INTEGRATION_ENABLED=false
GITLAB_SELF_HOSTED_ENABLED=true
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_WEB_URL=https://gitlab.com
GITLAB_OAUTH_SCOPES=api,openid
GITLAB_CONNECTION_STATE_TTL=600
EXPO_INTEGRATION_ENABLED=false
EXPO_API_URL=https://api.expo.dev
EXPO_GRAPHQL_URL=https://api.expo.dev/graphql
EXPO_WEB_URL=https://expo.dev
EXPO_REQUEST_TIMEOUT=30
OUTBOUND_WEBHOOKS_ENABLED=false
SENTRY_RELAY_ENABLED=true
SENTRY_MAX_ENVELOPE_BYTES=10485760

CREDENTIAL_STORAGE_MODES=local,external
CREDENTIALS_API_PROFILE=full

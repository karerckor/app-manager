---
interface Props {
  title: string;
  activeNav?: string;
}

const { title, activeNav } = Astro.props;

// A subtree opens only while the reader is inside it, so the CLI section does not
// push the rest of the sidebar off the screen from every other page.
const isWithin = (href: string): boolean =>
  activeNav === href || (activeNav?.startsWith(`${href}/`) ?? false);

const navSections = [
  {
    title: 'Overview',
    items: [
      { label: 'Introduction', href: '/' },
      { label: 'Getting Started', href: '/getting-started' },
      { label: 'Self-hosting', href: '/self-hosting' },
      { label: 'Deployment modes', href: '/deployment-modes' },
    ],
  },
  {
    title: 'Platform (Web UI)',
    items: [
      { label: 'Overview', href: '/platform' },
      { label: 'Applications', href: '/platform/applications' },
      { label: 'Files and assets', href: '/platform/files-and-assets' },
      { label: 'Builds', href: '/platform/builds' },
      { label: 'Credentials Vault', href: '/platform/credentials-vault' },
      { label: 'API keys', href: '/platform/api-keys' },
      { label: 'Audit log', href: '/platform/audit-log' },
      {
        label: 'Integrations',
        href: '/platform/integrations',
        children: [
          { label: 'EAS', href: '/platform/integrations/eas' },
          { label: 'Pipelines', href: '/platform/integrations/pipelines' },
          { label: 'Webhooks', href: '/platform/integrations/webhooks' },
          { label: 'Notifications', href: '/platform/integrations/notifications' },
          { label: 'Sentry', href: '/platform/integrations/sentry' },
        ],
      },
      { label: 'Team access', href: '/platform/team-access' },
      { label: 'Push notifications', href: '/platform/push-notifications' },
    ],
  },
  {
    title: 'API',
    items: [
      { label: 'API Reference', href: '/api-reference' },
    ],
  },
  {
    title: 'CLI (appmctl)',
    items: [
      { label: 'Overview', href: '/cli' },
      { label: 'Installation', href: '/cli/installation' },
      { label: 'Configuration', href: '/cli/configuration' },
      { label: 'Applications', href: '/cli/applications' },
      { label: 'Identifiers', href: '/cli/identifiers' },
      { label: 'Credentials', href: '/cli/credentials' },
      { label: 'Files', href: '/cli/files' },
      {
        label: 'Builds',
        href: '/cli/builds',
        children: [
          { label: 'Manual builds', href: '/cli/builds/manual-builds' },
          { label: 'Automated builds', href: '/cli/builds/automated-builds' },
          { label: 'EAS builds', href: '/cli/builds/eas-builds' },
        ],
      },
      {
        label: 'Integrations',
        href: '/cli/integrations',
        children: [
          { label: 'EAS', href: '/cli/integrations/eas' },
          { label: 'Pipelines', href: '/cli/integrations/pipelines' },
          { label: 'Webhooks', href: '/cli/integrations/webhooks' },
          { label: 'Sentry & telemetry', href: '/cli/integrations/sentry' },
          { label: 'Notifications', href: '/cli/integrations/notifications' },
        ],
      },
      { label: 'Examples', href: '/cli/examples' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | App Manager Docs</title>
    <style is:global>
      /* An inline script in <head> resolves the reader's choice (or their system
         preference) into data-theme before first paint, so every themed rule keys
         off that attribute rather than a media query. */
      :root,
      :root[data-theme='light'] {
        --bg: #ffffff;
        --bg-sidebar: #f7f8fa;
        --bg-hover: #eceef2;
        --bg-code: #f4f5f7;
        --text: #1a1a2e;
        --text-muted: #5c6670;
        --text-link: #2563eb;
        --border: #dee2e8;
        --accent: #2563eb;
        --sidebar-width: 260px;
        --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        --font-mono: 'SF Mono', 'Fira Code', 'Fira Mono', 'Roboto Mono', Consolas, monospace;
      }

      :root[data-theme='dark'] {
        --bg: #0d1117;
        --bg-sidebar: #161b22;
        --bg-hover: #21262d;
        --bg-code: #1c2128;
        --text: #e6edf3;
        --text-muted: #8b949e;
        --text-link: #58a6ff;
        --border: #30363d;
        --accent: #58a6ff;
      }

      :root[data-theme='light'] {
        color-scheme: light;
      }

      :root[data-theme='dark'] {
        color-scheme: dark;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--text);
      }

      body {
        display: flex;
        min-height: 100vh;
        /* Scalar paints the body from its own palette (inside @layer scalar-base,
           which any unlayered rule outranks). Left alone, the API Reference page
           dragged its dark background across the whole light-theme layout. */
        background: var(--bg);
      }

      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--sidebar-width);
        height: 100vh;
        background: var(--bg-sidebar);
        border-right: 1px solid var(--border);
        overflow-y: auto;
        padding: 24px 0;
        z-index: 10;
      }

      .sidebar-title {
        padding: 0 20px;
        font-size: 18px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 24px;
        letter-spacing: -0.02em;
      }

      .sidebar-title a {
        color: inherit;
        text-decoration: none;
      }

      .nav-section {
        margin-bottom: 20px;
      }

      .nav-section-title {
        padding: 0 20px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 8px;
      }

      .nav-link {
        display: block;
        padding: 6px 20px;
        font-size: 14px;
        color: var(--text-muted);
        text-decoration: none;
        transition: all 0.15s ease;
      }

      .nav-link:hover {
        color: var(--text);
        background: var(--bg-hover);
      }

      /* Items with a subtree get a chevron so the nesting is visible while collapsed. */
      .nav-link-parent {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
      }

      .nav-chevron {
        flex-shrink: 0;
        width: 12px;
        height: 12px;
        opacity: 0.6;
        transition: transform 0.15s ease;
      }

      .nav-link-parent.expanded .nav-chevron {
        transform: rotate(90deg);
      }

      .nav-link-child {
        padding-left: 34px;
        font-size: 13px;
      }

      .nav-link-grandchild {
        padding-left: 48px;
        font-size: 13px;
      }

      .nav-link.active {
        color: var(--accent);
        background: var(--bg-hover);
        font-weight: 500;
        border-right: 2px solid var(--accent);
      }

      .main-content {
        margin-left: var(--sidebar-width);
        flex: 1;
        min-width: 0;
      }

      .content {
        max-width: 800px;
        margin: 0 auto;
        padding: 40px 48px;
      }

      @media (max-width: 768px) {
        .sidebar {
          display: none;
        }
        .main-content {
          margin-left: 0;
        }
        .content {
          padding: 24px 20px;
        }
      }

      .content h1 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
      }

      .content h2 {
        font-size: 24px;
        font-weight: 600;
        margin-top: 40px;
        margin-bottom: 12px;
        letter-spacing: -0.01em;
      }

      .content h3 {
        font-size: 18px;
        font-weight: 600;
        margin-top: 28px;
        margin-bottom: 8px;
      }

      .content p {
        margin-bottom: 16px;
        line-height: 1.7;
      }

      .content a {
        color: var(--text-link);
        text-decoration: none;
      }

      .content a:hover {
        text-decoration: underline;
      }

      .content code {
        font-family: var(--font-mono);
        font-size: 0.9em;
        background: var(--bg-code);
        padding: 2px 6px;
        border-radius: 4px;
      }

      .content pre {
        background: var(--bg-code);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 16px;
        overflow-x: auto;
        margin-bottom: 16px;
      }

      .content pre code {
        background: none;
        padding: 0;
        font-size: 14px;
      }

      .content table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 16px;
      }

      .content th, .content td {
        text-align: left;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
        font-size: 14px;
      }

      .content th {
        font-weight: 600;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
      }

      .content ul, .content ol {
        margin-bottom: 16px;
        padding-left: 24px;
      }

      .content li {
        margin-bottom: 4px;
        line-height: 1.6;
      }

      .content hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 32px 0;
      }

      .badge {
        display: inline-block;
        padding: 2px 8px;
        font-size: 12px;
        font-weight: 500;
        border-radius: 4px;
        background: var(--bg-code);
        color: var(--text-muted);
      }

      .badge.get { color: #22863a; background: #dcffe4; }
      .badge.post { color: #0366d6; background: #dbedff; }
      .badge.patch { color: #735c0f; background: #fff5b1; }
      .badge.delete { color: #cb2431; background: #ffeef0; }

      :root[data-theme='dark'] .badge.get { color: #3fb950; background: #1b3a2a; }
      :root[data-theme='dark'] .badge.post { color: #58a6ff; background: #1a3050; }
      :root[data-theme='dark'] .badge.patch { color: #d29922; background: #3d2e00; }
      :root[data-theme='dark'] .badge.delete { color: #f85149; background: #3d1a1e; }

      .theme-toggle {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: var(--bg-sidebar);
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.15s ease, background 0.15s ease;
      }

      .theme-toggle:hover {
        color: var(--text);
        background: var(--bg-hover);
      }

      .theme-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* One icon per theme; the inactive one is removed from the box entirely so
         the button keeps its size. */
      .theme-toggle .icon-dark {
        display: none;
      }

      :root[data-theme='dark'] .theme-toggle .icon-light {
        display: none;
      }

      :root[data-theme='dark'] .theme-toggle .icon-dark {
        display: block;
      }

      @media (max-width: 768px) {
        /* No sidebar to tuck the button beside, so keep it clear of the heading. */
        .content {
          padding-top: 64px;
        }
      }
    </style>
    <script is:inline>
      // Runs before first paint so a dark-theme reader never sees a white flash.
      (() => {
        const stored = localStorage.getItem('docs-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme">
      <svg class="icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.8" />
        <path
          d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        />
      </svg>
      <svg class="icon-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
    <nav class="sidebar">
      <div class="sidebar-title">
        <a href="/">App Manager</a>
      </div>
      {navSections.map((section) => (
        <div class="nav-section">
          <div class="nav-section-title">{section.title}</div>
          {section.items.map((item) => (
            <Fragment>
              <a
                href={item.href}
                class:list={[
                  'nav-link',
                  {
                    active: activeNav === item.href,
                    'nav-link-parent': !!item.children,
                    expanded: !!item.children && isWithin(item.href),
                  },
                ]}
              >
                <span>{item.label}</span>
                {item.children && (
                  <svg class="nav-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="M6 4l4 4-4 4"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </a>
              {item.children && isWithin(item.href) && item.children.map((child) => (
                <Fragment>
                  <a
                    href={child.href}
                    class:list={[
                      'nav-link',
                      'nav-link-child',
                      {
                        active: activeNav === child.href,
                        'nav-link-parent': !!child.children,
                        expanded: !!child.children && isWithin(child.href),
                      },
                    ]}
                  >
                    <span>{child.label}</span>
                    {child.children && (
                      <svg class="nav-chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path
                          d="M6 4l4 4-4 4"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                  </a>
                  {child.children && isWithin(child.href) && child.children.map((grandchild) => (
                    <a
                      href={grandchild.href}
                      class:list={['nav-link', 'nav-link-grandchild', { active: activeNav === grandchild.href }]}
                    >
                      {grandchild.label}
                    </a>
                  ))}
                </Fragment>
              ))}
            </Fragment>
          ))}
        </div>
      ))}
    </nav>
    <main class="main-content">
      <div class="content">
        <slot />
      </div>
    </main>
    <script is:inline>
      const applyTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        // Embedded widgets (the Scalar API reference) theme themselves and cannot
        // read our custom properties, so they listen for this instead.
        document.dispatchEvent(new CustomEvent('docs:themechange', { detail: { theme } }));
      };

      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('docs-theme', next);
        applyTheme(next);
      });

      // Until the reader picks a side, keep following the OS.
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
        if (!localStorage.getItem('docs-theme')) {
          applyTheme(event.matches ? 'dark' : 'light');
        }
      });
    </script>
  </body>
</html>

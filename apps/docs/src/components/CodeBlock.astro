---
import { codeToHtml } from 'shiki';

interface Props {
  code: string;
  lang?: string;
}

const { code, lang = 'bash' } = Astro.props;

const decoded = code
  .replace(/&#123;/g, '{')
  .replace(/&#125;/g, '}')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&amp;/g, '&');

// Both palettes are emitted as --shiki-light / --shiki-dark custom properties on
// every token, so switching themes is a CSS swap with no re-highlighting. Without
// this the dark palette rendered on the light background, where most tokens were
// too pale to read.
const raw = await codeToHtml(decoded, {
  lang,
  themes: {
    light: 'github-light',
    dark: 'github-dark',
  },
  defaultColor: false,
});

// Merge our class into Shiki's existing class attribute
const html = raw.replace(
  /<pre([^>]*)class="([^"]*)"([^>]*)>/,
  '<pre$1class="code-block $2"$3>'
);
---

<Fragment set:html={html} />

<style is:global>
  .code-block {
    background: var(--bg-code) !important;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px !important;
    overflow-x: auto;
    margin-bottom: 16px;
    font-size: 14px;
    line-height: 1.6;
  }

  .code-block code,
  .code-block code span {
    font-family: var(--font-mono) !important;
  }

  /* Shiki's own background is dropped in favour of --bg-code above, so only the
     token colours are picked up from the active palette. */
  .code-block,
  .code-block span {
    color: var(--shiki-light);
  }

  :root[data-theme='dark'] .code-block,
  :root[data-theme='dark'] .code-block span {
    color: var(--shiki-dark);
  }
</style>

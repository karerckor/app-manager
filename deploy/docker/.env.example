# ==============================================================================
# Required
# ==============================================================================
# Generate once and keep it safe — every credential is encrypted with it:
#   docker run --rm --entrypoint app-manager ghcr.io/karerckor/app-manager-platform:latest generate-key
# Append it rather than editing the line below: the last definition of a
# variable in this file is the one Compose passes to the containers.
#   echo "APP_KEY=$(docker run --rm --entrypoint app-manager ghcr.io/karerckor/app-manager-platform:latest generate-key)" >> .env
# APP_KEY=
# The URL users open. Must match the scheme they actually use.
APP_URL=http://localhost:8000
APP_PORT=8000
# Any password you choose. Compose refuses to start while this is empty.
DB_PASSWORD=

# ==============================================================================
# Baseline — sensible for a container, change only if you know why
# ==============================================================================
APP_NAME="App Manager"
APP_ENV=production
APP_DEBUG=false
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app_manager
DB_USERNAME=app_manager
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
MEDIA_STORAGE_DRIVER=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Fortify's public sign-up form. Keep it closed on anything reachable from the internet.
ALLOW_PUBLIC_REGISTRATION=false

# ==============================================================================
# First run — pick one
# ==============================================================================
# installer: create the first owner in the browser at /install (default)
# admin:     create the first owner from the ADMIN_* variables below
# demo:      seed the demo account demo@example.com / Demo123! (disposable data;
#            the only mode that generates its own APP_KEY when you haven't set
#            one, storing it in the storage-app volume so restarts reuse it, and
#            the only mode that needs APP_ENV=local: the demo seeder is disabled
#            in production)
APP_MANAGER_BOOTSTRAP=installer
# ADMIN_NAME="Owner"
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=
# ADMIN_TEAM_NAME="My Team"

# ==============================================================================
# Credential handling
# ==============================================================================
# Which storage modes teams may use. "local" = App Manager holds the secret,
# "external" = it holds only a reference into your own vault (BYOV).
# local,external (default) | external | local
CREDENTIAL_STORAGE_MODES=local,external
# full (default) | dashboard_only — dashboard_only removes every endpoint that
# moves secret material, and suppresses credential webhooks and notifications.
CREDENTIALS_API_PROFILE=full

# ==============================================================================
# TLS — docker compose --profile tls up -d
# ==============================================================================
# Caddy terminates TLS for APP_DOMAIN and proxies to app:8080. Uncomment all
# five: they redefine APP_URL and APP_PORT from the Required block above, and
# the last definition wins.
#
# TRUSTED_PROXIES=* honours X-Forwarded-For and X-Forwarded-Proto from any peer,
# which is only acceptable while nothing but Caddy can reach the app — hence
# binding the plaintext port to loopback. Leave it on 0.0.0.0 and a client can
# forge its own address, and that address is both the login throttle key and the
# actor recorded in the credential-access audit log.
# APP_DOMAIN=appmanager.example.com
# APP_URL=https://appmanager.example.com
# APP_PORT=127.0.0.1:8000
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=*

# ==============================================================================
# Optional — integrations, mail, S3 media storage
# ==============================================================================
# Leave these to the web installer unless you provision instances from config.
# INTEGRATIONS_ENABLED=true
# GITHUB_INTEGRATION_ENABLED=true
# GITLAB_INTEGRATION_ENABLED=true
# EXPO_INTEGRATION_ENABLED=true
# OUTBOUND_WEBHOOKS_ENABLED=true
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=app-manager@example.com
# MEDIA_STORAGE_DRIVER=s3
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_USE_PATH_STYLE_ENDPOINT=false
